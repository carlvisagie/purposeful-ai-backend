# Flask Configuration
SECRET_KEY=your-secret-key-here-change-in-production
FLASK_ENV=development
JWT_SECRET_KEY=your-jwt-secret-key-here-change-in-production

# Database Configuration
DATABASE_URL=sqlite:///purposeful.db

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key-here
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key-here

# Email Configuration (for crisis alerts)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
CRISIS_ALERT_EMAIL=crisis-team@yourcompany.com
EMERGENCY_CONTACT_PHONE=+1-555-CRISIS

# Production Database (PostgreSQL)
# DATABASE_URL=postgresql://username:password@localhost:5432/purposeful_live

# Frontend URL
FRONTEND_URL=https://purposefullivecoaching.academy

# SendGrid Configuration (Email)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=support@purposefullivecoaching.academy
SENDGRID_FROM_NAME=Purposeful Live Coaching

# Stripe Webhook Configuration
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Stripe Price IDs (from Stripe Dashboard)
STRIPE_PRICE_ID_SHIFT_SESSION=price_xxx
STRIPE_PRICE_ID_CLARITY_PLUS=price_xxx
STRIPE_PRICE_ID_MASTERY=price_xxx

# Calendly Configuration (Scheduling)
CALENDLY_API_KEY=your-calendly-api-key
CALENDLY_WEBHOOK_SIGNING_KEY=your-calendly-webhook-signing-key

# Zoom Configuration (Video Meetings)
ZOOM_API_KEY=your-zoom-api-key
ZOOM_API_SECRET=your-zoom-api-secret
ZOOM_WEBHOOK_SECRET_TOKEN=your-zoom-webhook-secret

# Twilio Configuration (WhatsApp)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=+14155238886

# Google Workspace Configuration (Calendar & Gmail)
GOOGLE_SERVICE_ACCOUNT_FILE=path/to/service-account.json
# OR use OAuth2 credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# PayPal Configuration (Alternative Payment)
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=sandbox  # or 'live' for production

# Error Monitoring & Alerting
ERROR_LOG_FILE=/var/log/purposeful-errors.log
ERROR_ALERT_THRESHOLD=10  # Number of errors before alerting
ALERT_EMAIL=admin@purposefullivecoaching.academy  # Email for error alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK  # Optional Slack integration
